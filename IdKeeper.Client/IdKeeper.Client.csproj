<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFramework>net10.0</TargetFramework>
		<Nullable>enable</Nullable>
		<ImplicitUsings>enable</ImplicitUsings>
		<GenerateDocumentationFile>true</GenerateDocumentationFile>
	</PropertyGroup>

	<!-- 의도적으로 IdKeeper.Common을 참조하지 않는다. 그 프로젝트는
	     <FrameworkReference Include="Microsoft.AspNetCore.App" />을 갖고 있어, 참조하면 이 패키지를
	     쓰는 쪽이 ASP.NET Core 앱이어야만 한다. 콘솔·워커 앱에서도 쓸 수 있어야 하므로 필요한 상수
	     몇 개는 이 프로젝트 안에 복사해 둔다(XApiKeyConstant 참고).
	     같은 이유로 IsTrimmable도 켜지 않는다 — 테스트가 private 멤버 리플렉션에 의존한다. -->
	<PropertyGroup>
		<PackageId>IdKeeper.Client</PackageId>
		<Title>IdKeeper Snowflake Client</Title>
		<Description>
			IdKeeper 서버에서 노드 Id를 임대받아 프로세스 내에서 SnowflakeId를 발급하는 클라이언트.
			임대 획득·주기적 갱신·정상 반납과 만료 시 발급 차단을 자동으로 처리한다.
		</Description>
		<PackageTags>snowflake;id;idgen;distributed-id;idkeeper</PackageTags>
		<PackageLicenseFile>license.md</PackageLicenseFile>
		<PackageReadmeFile>README.md</PackageReadmeFile>
		<PackageIcon>icon.png</PackageIcon>
		<PackageProjectUrl>https://github.com/rossheo/IdKeeper</PackageProjectUrl>
		<RepositoryUrl>https://github.com/rossheo/IdKeeper</RepositoryUrl>
		<RepositoryType>git</RepositoryType>
		<PublishRepositoryUrl>true</PublishRepositoryUrl>
	</PropertyGroup>

	<ItemGroup>
		<None Include="..\license.md" Pack="true" PackagePath="\" />
		<None Include="..\icon.png" Pack="true" PackagePath="\" Visible="false" />
		<None Include="README.md" Pack="true" PackagePath="\" />
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="IdGen" />
		<PackageReference Include="Microsoft.Extensions.Diagnostics.HealthChecks" />
		<PackageReference Include="Microsoft.Extensions.Hosting.Abstractions" />
		<PackageReference Include="Microsoft.Extensions.Http" />
		<PackageReference Include="Microsoft.Extensions.Http.Resilience" />
		<PackageReference Include="Microsoft.Extensions.Options.DataAnnotations" />
	</ItemGroup>

</Project>
